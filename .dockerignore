# Ignore build artifacts except the Dioxus web+server bundle
target/*
!target/dx/
target/dx/*
!target/dx/taskmaster/
target/dx/taskmaster/*
!target/dx/taskmaster/debug/
!target/dx/taskmaster/release/
target/dx/taskmaster/debug/*
!target/dx/taskmaster/debug/web/
target/dx/taskmaster/debug/web/server-*
target/dx/taskmaster/release/*
!target/dx/taskmaster/release/web/
target/dx/taskmaster/release/web/server-*

# Ignore version control and local development artifacts
.git
.gitignore
data/*.db
data/*.db-*

